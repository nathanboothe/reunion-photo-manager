@page
@model ReunionPhotos.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="login-card">
    <h1>Welcome back</h1>
    <p class="subtitle">Enter your PIN to see the family photos.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error-message">@Model.ErrorMessage</p>
    }

    <form method="post">
        <label for="pin">PIN</label>
        <input type="password" inputmode="numeric" id="pin" name="Pin" autocomplete="off" autofocus required />
        <button type="submit">Log in</button>
    </form>
</div>
