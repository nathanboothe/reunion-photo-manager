# Copy this file to .env for local development and fill in real values.
# On Render, set these same keys under the service's Environment tab instead.

PORT=3000
NODE_ENV=development

# Any long random string - used to sign login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Only change these if you named your Airtable tables differently.
AIRTABLE_ALBUMS_TABLE=Albums
AIRTABLE_PHOTOS_TABLE=Photos
AIRTABLE_ENTRIES_TABLE=Entries
AIRTABLE_FAMILY_MEMBERS_TABLE=FamilyMembers
AIRTABLE_CONFIG_TABLE=AppConfig

GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_REFRESH_TOKEN=
GRAPH_SYNC_INTERVAL_MINUTES=60
